{
  "name": "sistema-modelo-saas",
  "version": "1.0.0",
  "description": "SaaS Educational Management System",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json && npm run build:frontend",
    "build:backend": "tsc --project tsconfig.json",
    "build:frontend": "cd src/frontend && npm run build",
    "start": "node dist/backend/server.js",
    "dev": "ts-node src/backend/server.ts",
    "test": "jest --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "db:backup": "bash scripts/backup.sh",
    "create-admin": "ts-node scripts/create-admin.ts",
    "import-csv": "ts-node scripts/import-csv.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
