# ===========================================
# Configuracao de Producao
# ===========================================

# Ambiente
NODE_ENV=production
PORT=3001

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha_segura@postgres:5432/saas_educacional?schema=public

# JWT - Gerar com: openssl rand -base64 64
JWT_SECRET=GERAR_COM_openssl_rand_-base64_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=GERAR_COM_openssl_rand_-base64_64
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Dominio de producao (separar multiplos com virgula)
CORS_ORIGIN=https://seu-dominio.com.br

# PostgreSQL (usado pelo docker-compose)
POSTGRES_USER=saas_edu
POSTGRES_PASSWORD=senha_segura_aqui
POSTGRES_DB=saas_educacional

# Frontend
NEXT_PUBLIC_API_URL=https://api.seu-dominio.com.br
